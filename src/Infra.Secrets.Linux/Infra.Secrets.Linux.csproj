<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.Infra.Secrets.Linux</RootNamespace>
    <AssemblyName>Eunomia.Infra.Secrets.Linux</AssemblyName>
    <!-- LibraryImport (P/Invoke gerado em compile time, seguro para AOT). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- APIs do Linux (libsecret) só em Infra.*.Linux (secção 21.8). -->
  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
  </ItemGroup>
</Project>
