<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.Infra.Secrets.Linux</RootNamespace>
    <AssemblyName>Eunomia.Infra.Secrets.Linux</AssemblyName>
    <!-- LibraryImport (P/Invoke generated at compile time, safe for AOT). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Linux APIs (libsecret) only in Infra.*.Linux (section 21.8). -->
  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
  </ItemGroup>
</Project>
