<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.Infra.Ssh</RootNamespace>
    <AssemblyName>Eunomia.Infra.Ssh</AssemblyName>
    <!-- LibraryImport for the Pageant transport (WM_COPYDATA), only used on Windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Infra.Ssh.Tests" />
  </ItemGroup>

  <!-- Implements ISshTunnelFactory (Drivers.Abstractions); ADR-09: SSH.NET + Eunomia's own agent client. -->
  <ItemGroup>
    <ProjectReference Include="..\Drivers.Abstractions\Drivers.Abstractions.csproj" />
  </ItemGroup>
</Project>
