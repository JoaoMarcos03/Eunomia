<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.App.Desktop</RootNamespace>
    <AssemblyName>Eunomia</AssemblyName>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Executable icon (Win32 resource; NativeAOT embeds it in Eunomia.exe). -->
    <ApplicationIcon>..\..\assets\brand\eunomia.ico</ApplicationIcon>
    <!-- Windows use the icon from UI.Controls.Common (BrandAssets); no second copy as the default icon. -->
    <AvaloniaIncludeApplicationIconAsWindowIcon>false</AvaloniaIncludeApplicationIconAsWindowIcon>
    <PublishAot>true</PublishAot>
    <!-- LibraryImport (P/Invoke generated at compile time, safe for AOT) needs unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI.Shell\UI.Shell.csproj" />
    <ProjectReference Include="..\Infra.Settings\Infra.Settings.csproj" />
    <ProjectReference Include="..\Infra.Observability\Infra.Observability.csproj" />
    <ProjectReference Include="..\Infra.Secrets.Windows\Infra.Secrets.Windows.csproj" />
    <ProjectReference Include="..\Infra.Secrets.MacOS\Infra.Secrets.MacOS.csproj" />
    <ProjectReference Include="..\Infra.Secrets.Linux\Infra.Secrets.Linux.csproj" />
    <ProjectReference Include="..\Infra.Ssh\Infra.Ssh.csproj" />
    <ProjectReference Include="..\Drivers.MySql\Drivers.MySql.csproj" />
  </ItemGroup>
</Project>
