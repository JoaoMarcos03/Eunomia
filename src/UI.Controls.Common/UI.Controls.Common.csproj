<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.UI.Controls.Common</RootNamespace>
    <AssemblyName>Eunomia.UI.Controls.Common</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- Theme tokens (section 21.7: themes are data, no code), embedded from assets/themes. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\themes\*.json" LogicalName="Eunomia.Themes.%(Filename).json" />
  </ItemGroup>

  <!-- Brand (assets/brand): window icon and logo, at avares://Eunomia.UI.Controls.Common/Brand/. -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\brand\eunomia.ico" Link="Brand\eunomia.ico" />
    <AvaloniaXaml Include="..\..\assets\brand\EunomiaLogo.axaml" Link="Brand\EunomiaLogo.axaml" />
  </ItemGroup>
</Project>
