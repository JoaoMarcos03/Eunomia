<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Eunomia.UI.Controls.Common.Brand.BrandResources">
  <!-- Brand logo (assets/brand/EunomiaLogo.axaml, generated outside the repo). Included in XAML so it is resolved at
       compile time (ResourceInclude in code is not safe for AOT). -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Eunomia.UI.Controls.Common/Brand/EunomiaLogo.axaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
