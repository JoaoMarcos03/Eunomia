<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.Infra.Secrets.MacOS</RootNamespace>
    <AssemblyName>Eunomia.Infra.Secrets.MacOS</AssemblyName>
    <!-- LibraryImport (P/Invoke generated at compile time, safe for AOT). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- macOS APIs (Keychain) only in Infra.*.MacOS (section 21.8). -->
  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
  </ItemGroup>
</Project>
