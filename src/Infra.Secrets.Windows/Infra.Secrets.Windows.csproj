<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Eunomia.Infra.Secrets.Windows</RootNamespace>
    <AssemblyName>Eunomia.Infra.Secrets.Windows</AssemblyName>
    <!-- LibraryImport (P/Invoke generated at compile time, safe for AOT). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Windows APIs only in Infra.*.Windows (section 21.8). -->
  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
  </ItemGroup>
</Project>
