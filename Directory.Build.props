<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Regras de estilo do .editorconfig com severidade warning também no build (e não só no editor). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Versões: 0.<fase>.<n> até ao MVP; a seguir 1.0.0-beta.<n> (Fase 14) até ao 1.0 estável. -->
    <Version>1.0.0-beta.1</Version>

    <!-- Analyzers de AOT e trimming em todos os projetos (secção 22). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- Bibliotecas em src/ declaram-se compatíveis com NativeAOT (liga também IsTrimmable). Separadores normalizados para
       a condição valer em Windows, Linux e macOS. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
