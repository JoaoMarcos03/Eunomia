<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig style rules with warning severity also apply in the build (not only in the editor). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Versions: 0.<phase>.<n> up to the MVP; then 1.0.0-beta.<n> (phase 14) until the stable 1.0. -->
    <Version>1.0.0-beta.1</Version>

    <!-- AOT and trimming analyzers in every project (spec section 22). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- Libraries in src/ declare themselves NativeAOT-compatible (which also turns on IsTrimmable). Separators are
       normalised so the condition holds on Windows, Linux and macOS. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
