<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.3" />
    <!-- AvaloniaEdit 12.0.0 declares Avalonia >= 12.0.0; it is used with 12.1.3 without a fork (criterion of spec section 20.2). -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup Label="Infra">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xUnit v3 stays on the 3.x line: Avalonia.Headless.XUnit 12.1.3 is compiled against xunit.v3.extensibility.core 3.2.2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup Label="Bench">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
