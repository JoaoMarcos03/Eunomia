<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.3" />
    <!-- AvaloniaEdit 12.0.0 declara Avalonia >= 12.0.0; é usado com a 12.1.3 sem fork (critério da secção 20.2). -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup Label="Infra">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!-- xUnit v3 fica na linha 3.x: Avalonia.Headless.XUnit 12.1.3 é compilado contra xunit.v3.extensibility.core 3.2.2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup Label="Bench">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
